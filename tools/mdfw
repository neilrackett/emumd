static bool app_poll(void) {
  /* One pass of the main loop; return true if there was work. */
  return false;
}

const mdfw_app_t mdfw_app = {
    .name = MDFW_NAME,
#ifdef MDFW_VERSION
    .version = MDFW_VERSION,
#endif
    .init = app_init,
    .poll = app_poll,
    /* Or, for a main loop that never returns: .main = app_main (see
     * EmuMD's docs/GUIDE.md) */
};
"""


def cmd_init(args):
    d = os.path.abspath(args.dir)
    name = args.name or os.path.basename(d)
    slug = "".join(c if c.isalnum() or c in "-_." else "-" for c in name.lower())
    made = []
    ini = os.path.join(d, "mdfw.ini")
    app = os.path.join(d, "emu", "mdfw_app.c")
    fill = lambda t: t.replace("{name}", name).replace("{slug}", slug)
    template = (os.path.isfile(os.path.join(d, "uuid.txt"))
                and os.path.isfile(os.path.join(d, "rp", "src", "main.c")))
    if template:
        arch = template_wifi_arch(os.path.join(d, "rp", "src", "CMakeLists.txt"))
        wifi = WIFI_INI_SECTION.replace("{arch}", arch) if arch else ""
        files = [(ini, fill(SIDECARTRIDGE_INI_TEMPLATE).replace("{wifi}", wifi))]
        print("  a SidecarTridge template firmware: its own main() runs")
    else:
        files = [(ini, fill(INI_TEMPLATE)), (app, fill(APP_TEMPLATE))]
    for path, text in files:
        if os.path.exists(path):
            print("  kept %s (already there)" % os.path.relpath(path))
            continue
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(text)
        made.append(path)
        print("  made %s" % os.path.relpath(path))
    if made and template:
        print("Next: check mdfw.ini against rp/src/CMakeLists.txt, then: mdfw build")
    elif made:
        print("Next: list your sources in mdfw.ini, fill in emu/mdfw_app.c, then: mdfw build")
    root = git_root(d) or d
    if not (ROOT + os.sep).startswith(root + os.sep):
        print("To pin EmuMD in this project (recommended), from %s:\n"
              "  git submodule add %s emu/emumd\n"
              "and then use emu/emumd/tools/mdfw." % (root, REPO_URL))
    print("For coding agents: mdfw skill install")


def template_wifi_arch(cmakelists):
    """poll or background, as the firmware links pico_cyw43_arch; or ""."""
    try:
        with open(cmakelists) as f:
            lines = [l.split("#", 1)[0] for l in f]
    except OSError:
        return ""
    text = " ".join(lines)
    if "pico_cyw43_arch_lwip_threadsafe_background" in text:
        return "background"
    return "poll" if "pico_cyw43_arch_lwip_poll" in text else ""


def git_root(path):
    r = subprocess.run(["git", "-C", path, "rev-parse", "--show-toplevel"],
                       capture_output=True, text=True)
    return os.path.realpath(r.stdout.strip()) if r.returncode == 0 else None


def project_from(args):
    return Project(args.file or "mdfw.ini")


def cmd_build(args):
    proj = project_from(args)
    if args.output:
        proj.output = os.path.abspath(args.output)
    out = build(proj, args.verbose, args.jobs, args.clean)
    abi, name, version = describe(out)
    print("%s: %s %s" % (os.path.relpath(out), name, version))


def hatari_path(args, proj=None):
    for p in (args.hatari, os.environ.get("EMUMD_HATARI"),
              proj.get("run", "hatari") if proj else "", DEFAULT_HATARI):
        if p:
            p = proj.path(p) if (proj and not os.path.isabs(p)) else p
            if os.path.exists(p):
                return p
    fail("no Hatari that loads .mdfw files; build one with: mdfw hatari")


def hatari_inputs_hash():
    h = hashlib.sha1()
    for rel in HATARI_INPUTS:
        with open(os.path.join(ROOT, rel), "rb") as f:
            h.update(f.read())
    return h.hexdigest()


def warn_if_stale(hatari):
    """Say so if this Hatari was built from another version of EmuMD."""
    stamp = os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(hatari))),
                         ".emumd-stamp")
    if not os.path.exists(stamp):
        return
    with open(stamp) as f:
        if f.read().strip() != hatari_inputs_hash():
            sys.stderr.write("mdfw: this Hatari was built from a different version of EmuMD; "
                             "rebuild it with: mdfw hatari\n")


def last_avi_frame(avi, png):
    """Hatari records PNG frames ('00dc' chunks): keep the last one."""
    try:
        with open(avi, "rb") as f:
            data = f.read()
    except OSError:  # Hatari stopped before its first frame
        return False
    last = None
    i = data.find(b"00dc")
    while i >= 0:
        size = int.from_bytes(data[i + 4:i + 8], "little")
        body = data[i + 8:i + 8 + size]
        if body[:8] == b"\x89PNG\r\n\x1a\n":
            last = body
        i = data.find(b"00dc", i + 8)
    if not last:
        return False
    with open(png, "wb") as f:
        f.write(last)
    return True


def cmd_run(args):
    proj = None
    if args.firmware:
        firmware = os.path.abspath(args.firmware)
        if os.path.exists("mdfw.ini") and not args.file:
            proj = Project("mdfw.ini")
    else:
        proj = project_from(args)
        firmware = build(proj, args.verbose, None, False)
    if args.file and not proj:
        proj = Project(args.file)

    def setting(opt, key):
        if opt is not None:
            return opt
        return proj.get("run", key) if proj else ""

    def as_path(p):
        return proj.path(p) if proj and not os.path.isabs(p) else os.path.abspath(p)

    hatari = hatari_path(args, proj)
    warn_if_stale(hatari)
    cmd = [hatari]
    env = dict(os.environ)
    tos = setting(args.tos, "tos")
    if tos:
        cmd += ["--tos", as_path(tos)]
    elif os.path.exists(DEFAULT_TOS):
        cmd += ["--tos", DEFAULT_TOS]
    machine = setting(args.machine, "machine")
    if machine:
        cmd += ["--machine", machine]
    hd = setting(args.harddrive, "harddrive")
    if hd:
        os.makedirs(as_path(hd), exist_ok=True)  # as sd: Hatari needs it there
        cmd += ["--harddrive", as_path(hd)]
    else:
        cmd += ["--harddrive", "none"]  # so the firmware's cartridge boots
    sd = setting(args.sd, "sd")
    if sd:
        os.makedirs(as_path(sd), exist_ok=True)
        cmd += ["--md-sd", as_path(sd)]
    options = list(proj.lines("run", "options")) if proj else []
    options += args.option or []
    for o in options:
        cmd += ["--md-option", o]
    if args.md_verbose:
        cmd += ["--md-verbose", "on"]

    hatari_args = shlex.split(proj.get("run", "hatari_args")) if proj else []
    hatari_args += args.hatari_args
    frames = args.frames or (500 if args.headless else 0)
    tmp = None
    if args.headless:
        env["SDL_VIDEODRIVER"] = "dummy"
        env["SDL_AUDIODRIVER"] = "dummy"
        if not args.record:  # a recording keeps it, though nothing plays
            cmd += ["--sound", "off"]
        cmd += ["--fast-boot", "on", "--fast-forward", "on"]
    if frames:
        cmd += ["--run-vbls", str(frames)]
    if (args.screenshot and not args.record) or args.no_user_config:
        tmp = tempfile.mkdtemp(prefix="mdfw-run-")
    avi = os.path.abspath(args.record) if args.record else (
        os.path.join(tmp, "screen.avi") if args.screenshot else None)
    if avi:
        # A screenshot is the last frame of a recording. Compress frames
        # lightly: at Hatari's default level, a busy picture slows a run
        # tenfold.
        cmd += ["--avirecord", "--avi-vcodec", "png", "--png-level", "1",
                "--avi-file", avi]
    if args.record:
        # Every frame, without the status bar, at the ST's rate (else the
        # 60 Hz it starts at, before TOS sets 50); -- --avi-fps N overrides.
        mono = ["--monitor", "mono"] in [hatari_args[i:i + 2]
                                         for i in range(len(hatari_args))]
        cmd += ["--frameskips", "0", "--crop", "on",
                "--avi-fps", "71" if mono else "50"]
    if args.no_user_config:
        env["HOME"] = tmp  # Hatari's own config lives under $HOME

    cmd += hatari_args
    cmd += ["--md-firmware", firmware]
    print(" ".join(shlex.quote(c) for c in cmd), flush=True)

    if not (frames or args.screenshot or args.log or tmp):
        os.execve(cmd[0], cmd, env)

    # Run it to the end (or the time limit), keeping what it says.
    log = open(args.log, "w", buffering=1) if args.log else None  # line by line
    proc = subprocess.Popen(cmd, env=env, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, text=True, errors="replace")
    import threading
    timed_out = threading.Event()

    def time_out():
        timed_out.set()
        proc.kill()

    timer = threading.Timer(args.timeout, time_out) if args.timeout else None
    if timer:
        timer.start()
    for line in proc.stdout:
        sys.stdout.write(line)
        if log:
            log.write(line)
    rc = proc.wait()
    if timer:
        timer.cancel()
    if log:
        log.close()
    if args.screenshot:
        if last_avi_frame(avi, args.screenshot):
            print("screenshot: %s" % args.screenshot)
        else:
            sys.stderr.write("mdfw: no frame recorded for the screenshot\n")
            rc = rc or 1
    if args.record and os.path.exists(avi):
        if rc < 0:  # Hatari had no chance to finish the file
            sys.stderr.write("mdfw: Hatari was stopped, so %s is unfinished\n"
                             % args.record)
        else:
            print("recording: %s" % args.record)
    if tmp:
        shutil.rmtree(tmp, ignore_errors=True)
    if rc < 0 and not timed_out.is_set():
        # Killed by a signal: a crash (the firmware's own, often), or the
        # abort() of a failed assertion or panic.
        sys.stderr.write("mdfw: Hatari was stopped by signal %d\n" % -rc)
        sys.exit(128 - rc)
    sys.exit(rc if rc and rc > 0 else 0)


def cmd_info(args):
    try:
        abi, name, version = describe(args.firmware)
    except (OSError, AttributeError) as e:
        fail("%s is not a .mdfw this computer can load (%s)" % (args.firmware, e))
    print("%s\n  name:      %s\n  version:   %s\n  interface: %d%s" % (
        args.firmware, name, version or "-", abi,
        "" if abi == PLUGIN_ABI else " (this EmuMD speaks %d)" % PLUGIN_ABI))


def cmd_cart(args):
    """A cartridge image (raw bytes as the ST sees them) as a C array of ST
    words, for mdfw_rom4_load()."""
    data = open(args.image, "rb").read()
    if len(data) > 0x10000:
        fail("%s is %d bytes; ROM4 holds 65536" % (args.image, len(data)))
    if len(data) % 2:
        data += b"\0"
    words = [(data[i] << 8) | data[i + 1] for i in range(0, len(data), 2)]
    while words and words[-1] == 0:
        words.pop()
    name = args.name
    out = ["/* %s as ST words (mdfw cart). */" % os.path.basename(args.image),
           "#include <stdint.h>",
           "static const uint16_t %s[] __attribute__((aligned(4))) = {" % name]
    for i in range(0, len(words), 12):
        out.append("    " + ", ".join("0x%04x" % w for w in words[i:i + 12]) + ",")
    out += ["};", "static const unsigned %s_length = %d;" % (name, len(words)), ""]
    text = "\n".join(out)
    if args.output:
        with open(args.output, "w") as f:
            f.write(text)
        print("  %s: %d words" % (args.output, len(words)))
    else:
        sys.stdout.write(text)


def cmd_skill(args):
    if args.action == "path":
        print(SKILL)
        return
    if args.user:
        base = os.path.join(os.path.expanduser("~"), ".claude", "skills")
        root = None
    else:
        start = os.path.abspath(args.dir)
        root = git_root(start) or start
        base = os.path.join(root, ".claude", "skills")
    dest = os.path.join(base, "emumd")
    if os.path.islink(dest):
        os.unlink(dest)
    elif os.path.exists(dest):
        if not args.force:
            fail("%s already exists (use --force to replace it)" % dest)
        shutil.rmtree(dest)
    os.makedirs(base, exist_ok=True)
    if args.copy:
        shutil.copytree(SKILL, dest)
        how = "copied"
    else:
        # Relative inside a project, so it works in every clone when
        # EmuMD is a submodule; absolute for --user.
        target = SKILL if args.user else os.path.relpath(SKILL, base)
        os.symlink(target, dest)
        how = "linked"
    print("  %s %s -> %s" % (how, dest, SKILL))
    real_skill = os.path.realpath(SKILL)
    if root and not args.copy and not real_skill.startswith(root + os.sep):
        print("  Note: EmuMD is outside this project, so other clones will not\n"
              "  have the skill. Add EmuMD as a submodule, or use --copy.")


def cmd_hatari(args):
    script = os.path.join(ROOT, "hatari", "build-hatari.sh")
    cmd = [script] + ([os.path.abspath(args.src)] if args.src else [])
    r = subprocess.run(cmd)
    sys.exit(r.returncode)


def main():
    ap = argparse.ArgumentParser(prog="mdfw", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="command", metavar="command")

    p = sub.add_parser("init", help="add mdfw.ini and a glue file to a firmware")
    p.add_argument("dir", nargs="?", default=".")
    p.add_argument("--name", help="firmware name (default: the folder's)")
    p.set_defaults(func=cmd_init)

    p = sub.add_parser("build", help="build the .mdfw described by mdfw.ini")
    p.add_argument("-f", "--file", help="the project file (default: ./mdfw.ini)")
    p.add_argument("-o", "--output", help="where to write the .mdfw")
    p.add_argument("-j", "--jobs", type=int, help="parallel compiles")
    p.add_argument("-v", "--verbose", action="store_true", help="show commands")
    p.add_argument("--clean", action="store_true", help="rebuild everything")
    p.set_defaults(func=cmd_build)

    p = sub.add_parser("run", help="run a .mdfw in Hatari")
    p.add_argument("firmware", nargs="?", help=".mdfw file (default: build mdfw.ini's)")
    p.add_argument("-f", "--file", help="the project file (default: ./mdfw.ini)")
    p.add_argument("--sd", help="folder standing in for the microSD card")
    p.add_argument("--tos", help="TOS image (default: the EmuTOS that "
                   "mdfw hatari downloaded)")
    p.add_argument("--machine", help="st, ste, megaste, ...")
    p.add_argument("--harddrive", help="GEMDOS drive C: folder (default: none)")
    p.add_argument("-O", "--option", action="append", metavar="KEY=VALUE",
                   help="pass --md-option KEY=VALUE (repeatable)")
    p.add_argument("-V", "--md-verbose", action="store_true",
                   help="show the firmware's debug output")
    p.add_argument("--hatari", help="the Hatari to use")
    p.add_argument("--headless", action="store_true",
                   help="no window or sound, as fast as possible (500 frames unless --frames)")
    p.add_argument("--frames", type=int, metavar="N", help="quit after N frames (VBLs)")
    p.add_argument("--screenshot", metavar="PNG", help="save the last frame as a PNG")
    p.add_argument("--record", metavar="AVI",
                   help="record video and sound (at 50 Hz; -- --avi-fps N for others)")
    p.add_argument("--log", metavar="FILE", help="also save Hatari's output to FILE")
    p.add_argument("--timeout", type=float, metavar="SECONDS",
                   help="stop Hatari after this long, whatever happens")
    p.add_argument("--no-user-config", action="store_true",
                   help="ignore your own Hatari settings")
    p.add_argument("-v", "--verbose", action="store_true", help="show build commands")
    p.set_defaults(func=cmd_run)
    p.epilog = "Anything after -- goes to Hatari as it is."

    p = sub.add_parser("info", help="say what a .mdfw is")
    p.add_argument("firmware")
    p.set_defaults(func=cmd_info)

    p = sub.add_parser("cart", help="turn a cartridge image into a C array")
    p.add_argument("image", help="raw cartridge image (bytes as the ST reads them)")
    p.add_argument("-o", "--output", help="header to write (default: stdout)")
    p.add_argument("-n", "--name", default="cart_image", help="array name")
    p.set_defaults(func=cmd_cart)

    p = sub.add_parser("skill", help="give coding agents the EmuMD skill")
    p.add_argument("action", choices=["install", "path"],
                   help="install it, or print where it is")
    p.add_argument("dir", nargs="?", default=".", help="project (default: here)")
    p.add_argument("--user", action="store_true",
                   help="for all your projects (~/.claude/skills), not just this one")
    p.add_argument("--copy", action="store_true", help="copy instead of linking")
    p.add_argument("--force", action="store_true", help="replace an existing copy")
    p.set_defaults(func=cmd_skill)

    p = sub.add_parser("hatari", help="build the Hatari that loads .mdfw files")
    p.add_argument("--src", help="Hatari source folder (default: %s)" % HATARI_SRC)
    p.set_defaults(func=cmd_hatari)

    argv = sys.argv[1:]
    extra = []
    if "--" in argv:
        extra = argv[argv.index("--") + 1:]
        argv = argv[:argv.index("--")]
    args = ap.parse_args(argv)
    if not getattr(args, "func", None):
        ap.print_help()
        sys.exit(1)
    args.hatari_args = extra
    args.func(args)


if __name__ == "__main__":
    main()
