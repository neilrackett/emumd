"""mdfw - build SidecarTridge Multi-device firmware for EmuMD.

A .mdfw is a firmware's own C sources, a small glue file and the
EmuMD runtime, built for this computer as one shared library that
the patched Hatari loads with --md-firmware (or as its last argument).
mdfw.ini in the firmware's repository says which sources to use.

  mdfw init [DIR]          add mdfw.ini and emu/mdfw_app.c to a firmware
  mdfw build               build the .mdfw that mdfw.ini describes
  mdfw run [FILE.mdfw]     run it in Hatari (builds first without FILE)
  mdfw info FILE.mdfw      say what a .mdfw is
  mdfw cart IMAGE          turn a cartridge image into a C array
  mdfw hatari              build the Hatari that loads .mdfw files
  mdfw skill install       give coding agents the EmuMD skill
"""

import argparse
import concurrent.futures
import configparser
import ctypes
import glob
import hashlib
import os
import platform
import shlex
import shutil
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
RUNTIME = os.path.join(ROOT, "runtime")
PLUGIN_ABI = 1
SKILL = os.path.join(ROOT, "skills", "emumd")
REPO_URL = "https://github.com/neilrackett/emumd.git"

# The patched Hatari is built once per user, not inside each project (where
# EmuMD is typically a submodule); build-hatari.sh uses the same place.
CACHE = os.environ.get("EMUMD_CACHE") or os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "emumd")
HATARI_SRC = os.path.join(CACHE, "hatari")
DEFAULT_HATARI = os.path.join(HATARI_SRC, "build", "src", "hatari")
# Downloaded by build-hatari.sh too; mdfw run's TOS unless told otherwise.
DEFAULT_TOS = os.path.join(CACHE, "emutos-256k-1.4", "etos256uk.img")
# What the patched Hatari is built from: build-hatari.sh stores their SHA-1
# as .emumd-stamp, so a Hatari older than this EmuMD is spotted.
HATARI_INPUTS = ["hatari/hatari-multidevice.patch", "hatari/multidevice.c",
                 "hatari/multidevice.h", "include/emumd_plugin.h"]


def fail(msg):
    sys.stderr.write("mdfw: %s\n" % msg)
    sys.exit(1)


# ---------------------------------------------------------------------------
# mdfw.ini
# ---------------------------------------------------------------------------

class Project:
    """mdfw.ini, with every path made absolute."""

    def __init__(self, path):
        if not os.path.isfile(path):
            fail("no %s here (make one with: mdfw init)" % path)
        self.ini = os.path.abspath(path)
        self.dir = os.path.dirname(self.ini)
        cp = configparser.ConfigParser(interpolation=None, inline_comment_prefixes=(";",))
        cp.read(self.ini)
        self.cp = cp
        self.name = self.get("firmware", "name") or os.path.basename(self.dir)
        self.version = self.get("firmware", "version")
        slug = "".join(c if c.isalnum() or c in "-_." else "-" for c in self.name.lower())
        self.output = self.path(self.get("firmware", "output") or "build/%s.mdfw" % slug)
        self.build_dir = self.path(self.get("firmware", "build_dir") or "build/mdfw")
        self.sources = self.globs(self.lines("sources", "files"))
        excluded = set(self.globs(self.lines("sources", "exclude"), must_match=False))
        self.sources = [s for s in self.sources if s not in excluded]
        self.shims = [self.path(p) for p in self.lines("compile", "shims")]
        self.includes = [self.path(p) for p in self.lines("compile", "include")]
        self.defines = self.lines("compile", "defines")
        self.cflags = shlex.split(self.get("compile", "cflags") or "-O2")
        self.cxxflags = shlex.split(self.get("compile", "cxxflags"))
        self.ldflags = shlex.split(self.get("compile", "ldflags") or "")

    def get(self, section, key):
        return self.cp.get(section, key, fallback="").strip()

    def lines(self, section, key):
        return [l.strip() for l in self.get(section, key).splitlines() if l.strip()]

    def path(self, p):
        return os.path.normpath(os.path.join(self.dir, os.path.expanduser(p)))

    def globs(self, patterns, must_match=True):
        out = []
        for pat in patterns:
            hits = sorted(glob.glob(self.path(pat), recursive=True))
            if not hits and must_match:
                fail("%s: nothing matches %r" % (os.path.basename(self.ini), pat))
            out.extend(h for h in hits if h not in out)
        return out


# ---------------------------------------------------------------------------
# Building
# ---------------------------------------------------------------------------

CXX_EXTENSIONS = (".cpp", ".cc", ".cxx")


def is_cxx(src):
    return src.endswith(CXX_EXTENSIONS)


def compiler(cxx=False):
    if cxx:
        return shlex.split(os.environ.get("CXX", "c++"))
    return shlex.split(os.environ.get("CC", "cc"))


def compile_flags(proj):
    """Flags for both languages; std_flags() adds the language standard."""
    # -fshort-enums: enums take the RP2040's sizes (arm-none-eabi's), so the
    # structures a firmware keeps in flash or shared memory are laid out
    # the same.
    flags = ["-fPIC", "-fvisibility=hidden", "-fshort-enums", "-g", "-Wall",
             "-Wno-unused-function", "-Wno-missing-braces"] + proj.cflags
    # Your shims, then the runtime's (they replace the Pico SDK, FatFs and
    # the templates' debug.h, even where your include folders have their
    # hardware versions), then your include folders.
    for inc in (proj.shims + [os.path.join(RUNTIME, "shim"), os.path.join(ROOT, "include")]
                + proj.includes + [RUNTIME]):
        flags.append("-I" + inc)
    flags.append('-DMDFW_NAME="%s"' % proj.name.replace('"', '\\"'))
    if proj.version:
        flags.append('-DMDFW_VERSION="%s"' % proj.version.replace('"', '\\"'))
    # As the Pico SDK's host platform has them: built with the SDK, not
    # for the RP2040 itself.
    flags += ["-DEMUMD=1", "-DPICO_BUILD=1", "-DPICO_ON_DEVICE=0"]
    for d in proj.defines:
        flags.append("-D" + d)
    return flags


def std_flags(proj, src):
    if is_cxx(src):
        return ["-std=gnu++17"] + proj.cxxflags
    return ["-std=gnu11"]


def object_for(proj, src):
    rel = os.path.relpath(src, ROOT if src.startswith(RUNTIME + os.sep) else proj.dir)
    rel = rel.replace("..", "_up").replace(os.sep, "__")
    sub = "runtime" if src.startswith(RUNTIME + os.sep) else "src"
    return os.path.join(proj.build_dir, sub, os.path.splitext(rel)[0] + ".o")


def out_of_date(obj, src):
    if not os.path.exists(obj):
        return True
    t = os.path.getmtime(obj)
    if os.path.getmtime(src) > t:
        return True
    dep = obj[:-2] + ".d"
    if not os.path.exists(dep):
        return True
    with open(dep) as f:
        text = f.read().replace("\\\n", " ")
    # "obj.o: src.c a.h b.h" then, from -MP, "a.h:" lines; the first line
    # has everything.
    first = text.split("\n", 1)[0]
    for name in first.split(":", 1)[-1].split():
        if not os.path.exists(name) or os.path.getmtime(name) > t:
            return True
    return False


def build(proj, verbose=False, jobs=None, clean=False):
    runtime_srcs = sorted(glob.glob(os.path.join(RUNTIME, "*.c")))
    srcs = proj.sources + runtime_srcs
    if not proj.sources:
        fail("%s lists no sources" % os.path.basename(proj.ini))
    flags = compile_flags(proj)
    os.makedirs(proj.build_dir, exist_ok=True)

    # Rebuild everything when the flags change.
    stamp = os.path.join(proj.build_dir, "flags")
    digest = hashlib.sha1(" ".join(compiler() + compiler(True) + flags + proj.cxxflags)
                          .encode()).hexdigest()
    old = open(stamp).read() if os.path.exists(stamp) else ""
    force = clean or old != digest

    work = []
    for src in srcs:
        obj = object_for(proj, src)
        if force or out_of_date(obj, src):
            work.append((src, obj))

    def cc(item):
        src, obj = item
        os.makedirs(os.path.dirname(obj), exist_ok=True)
        cmd = (compiler(is_cxx(src)) + std_flags(proj, src) + flags
               + ["-MMD", "-MP", "-c", src, "-o", obj])
        r = subprocess.run(cmd, capture_output=True, text=True)
        return src, cmd, r

    failed = False
    with concurrent.futures.ThreadPoolExecutor(jobs or os.cpu_count() or 4) as pool:
        for src, cmd, r in pool.map(cc, work):
            print("  CC   %s" % os.path.relpath(
                src, ROOT if src.startswith(RUNTIME + os.sep) else proj.dir))
            if verbose:
                print("       " + " ".join(shlex.quote(c) for c in cmd))
            if r.stdout or r.stderr:
                sys.stderr.write(r.stdout + r.stderr)
            if r.returncode:
                failed = True
    if failed:
        fail("compile failed")
    with open(stamp, "w") as f:
        f.write(digest)

    objs = [object_for(proj, s) for s in srcs]
    newest = max(os.path.getmtime(o) for o in objs)
    if not work and os.path.exists(proj.output) and os.path.getmtime(proj.output) >= newest:
        print("  %s is up to date" % os.path.relpath(proj.output))
        return proj.output

    os.makedirs(os.path.dirname(proj.output), exist_ok=True)
    # The C++ driver links in its runtime library when there is C++.
    link = (compiler(any(is_cxx(s) for s in srcs))
            + ["-shared", "-o", proj.output] + objs + proj.ldflags + ["-lpthread"])
    if platform.system() == "Linux":
        # Keep the firmware's symbols to itself, and report missing ones now.
        link += ["-Wl,-Bsymbolic", "-Wl,-z,defs"]
    print("  LINK %s" % os.path.relpath(proj.output))
    if verbose:
        print("       " + " ".join(shlex.quote(c) for c in link))
    r = subprocess.run(link, capture_output=True, text=True)
    if r.returncode:
        sys.stderr.write(r.stdout + r.stderr)
        if "ndefined" in r.stderr:
            sys.stderr.write(
                "\nmdfw: the firmware calls functions the runtime does not provide.\n"
                "Leave the sources that set up hardware out of mdfw.ini, and define\n"
                "any other missing function in your glue file (or a shim .c).\n")
        fail("link failed")
    return proj.output


# ---------------------------------------------------------------------------
# Looking at a .mdfw
# ---------------------------------------------------------------------------

class _Plugin(ctypes.Structure):
    _fields_ = [("abi", ctypes.c_uint32), ("name", ctypes.c_char_p),
                ("version", ctypes.c_char_p)]


def describe(path):
    """(abi, name, version) of a .mdfw, or raise."""
    lib = ctypes.CDLL(os.path.abspath(path), mode=getattr(ctypes, "RTLD_LOCAL", 0))
    entry = lib.emumd_plugin_v1
    entry.restype = ctypes.POINTER(_Plugin)
    p = entry().contents
    return p.abi, p.name.decode(errors="replace"), (p.version or b"").decode(errors="replace")


