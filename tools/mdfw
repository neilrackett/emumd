# Building
# ---------------------------------------------------------------------------

CXX_EXTENSIONS = (".cpp", ".cc", ".cxx")


def is_cxx(src):
    return src.endswith(CXX_EXTENSIONS)


def compiler(cxx=False):
    if cxx:
        return shlex.split(os.environ.get("CXX", "c++"))
    return shlex.split(os.environ.get("CC", "cc"))


def compile_flags(proj):
    """Flags for both languages; std_flags() adds the language standard."""
    # -fshort-enums: enums take the RP2040's sizes (arm-none-eabi's), so the
    # structures a firmware keeps in flash or shared memory are laid out
    # the same.
    # No _FORTIFY_SOURCE (macOS and Ubuntu turn it on): firmware treats its
    # linker symbols (`extern unsigned int __rom_in_ram_start__`) as the
    # regions they start, which its checks would take for overflows.
    flags = ["-fPIC", "-fvisibility=hidden", "-fshort-enums", "-g", "-Wall",
             "-Wno-unused-function", "-Wno-missing-braces",
             "-U_FORTIFY_SOURCE", "-D_FORTIFY_SOURCE=0"] + proj.cflags
    # Your shims, then the runtime's (they replace the Pico SDK, FatFs and
    # the templates' debug.h, even where your include folders have their
    # hardware versions), then your include folders (one has your
    # lwipopts.h, for Wi-Fi), then lwIP's.
    template_shim = [os.path.join(RUNTIME, "template", "shim")] if proj.template else []
    wifi_shim = [os.path.join(RUNTIME, "wifi", "shim")] if proj.wifi else []
    lwip_inc = [os.path.join(proj.lwip_dir, "src", "include")] if proj.wifi else []
    for inc in (proj.shims + [os.path.join(RUNTIME, "shim")] + template_shim + wifi_shim
                + [os.path.join(ROOT, "include")] + proj.includes + lwip_inc + [RUNTIME]):
        flags.append("-I" + inc)
    if proj.template:
        flags += ["-include", os.path.join(RUNTIME, "template", "shim", "emumd_template.h")]
    flags.append('-DMDFW_NAME="%s"' % proj.name.replace('"', '\\"'))
    if proj.version:
        flags.append('-DMDFW_VERSION="%s"' % proj.version.replace('"', '\\"'))
    # As the Pico SDK's host platform has them: built with the SDK, not
    # for the RP2040 itself.
    flags += ["-DEMUMD=1", "-DPICO_BUILD=1", "-DPICO_ON_DEVICE=0"]
    if proj.wifi:
        # As a Pico W build has them: its board's pins, cyw43_arch on lwIP.
        flags += ["-DCYW43_WL_GPIO_LED_PIN=0", "-DCYW43_WL_GPIO_SMPS_PIN=1",
                  "-DCYW43_WL_GPIO_VBUS_PIN=2", "-DPICO_CYW43_SUPPORTED=1",
                  "-DCYW43_LWIP=1", "-DLIB_PICO_CYW43_ARCH=1",
                  "-D" + WIFI_ARCHES[proj.wifi_arch]]
    if proj.template:
        flags += ["-D" + d for d in template_defines(proj)]
    for d in proj.defines:
        flags.append("-D" + d)
    return flags


def template_defines(proj):
    """What the template's CMakeLists.txt defines, unless mdfw.ini does."""
    mine = {d.split("=", 1)[0] for d in proj.defines}
    callbacks = False
    for inc in proj.shims + proj.includes:
        try:
            with open(os.path.join(inc, "romemul.h")) as f:
                callbacks = "IRQInterceptionCallback requestCallback" in f.read()
            break
        except OSError:
            pass
    defaults = [
        'CURRENT_APP_UUID_KEY="%s"' % proj.uuid,
        "RELEASE_VERSION=" + ("MDFW_VERSION" if proj.version else '"emumd"'),
        'RELEASE_TYPE="emumd"', "RELEASE_DATE=__DATE__", 'LATEST_RELEASE_URL=""',
        "_DEBUG=1", "DISPLAY_ATARIST", "BOARD_TYPE_PICO_W=1", "BOARD_TYPE_PICO=0",
        "BOARD_TYPE_CUSTOM16MB=0", "PICO_FLASH_SPI_CLKDIV=2",
        "PICO_FLASH_SIZE_BYTES=(2*1024*1024)",
        "EMUMD_ROMEMUL_CALLBACKS=%d" % callbacks]
    return [d for d in defaults if d.split("=", 1)[0] not in mine]


def std_flags(proj, src):
    if is_cxx(src):
        return ["-std=gnu++17"] + proj.cxxflags
    return ["-std=gnu11"]


def source_base(proj, src):
    """(folder its name is relative to, build subfolder) for a source."""
    if src.startswith(RUNTIME + os.sep):
        return ROOT, "runtime"
    if proj.lwip_dir and src.startswith(proj.lwip_dir + os.sep):
        return os.path.dirname(proj.lwip_dir), "lwip"
    return proj.dir, "src"


def object_for(proj, src):
    base, sub = source_base(proj, src)
    rel = os.path.relpath(src, base).replace("..", "_up").replace(os.sep, "__")
    return os.path.join(proj.build_dir, sub, os.path.splitext(rel)[0] + ".o")


def lwip_source(proj):
    """The lwIP that [wifi] builds: mdfw.ini's, or the Pico SDK's version,
    downloaded once."""
    d = proj.lwip
    if not d:
        d = os.path.join(CACHE, "lwip-" + LWIP_VERSION)
        if not os.path.isdir(d):
            print("  Downloading lwIP %s" % LWIP_VERSION)
            tmp = d + ".part"
            shutil.rmtree(tmp, ignore_errors=True)
            os.makedirs(CACHE, exist_ok=True)
            tag = "STABLE-%s_RELEASE" % LWIP_VERSION.replace(".", "_")
            r = subprocess.run(["git", "-c", "advice.detachedHead=false", "clone", "-q",
                                "--depth", "1", "--branch", tag, LWIP_GIT, tmp],
                               capture_output=True, text=True)
            if r.returncode:
                shutil.rmtree(tmp, ignore_errors=True)
                sys.stderr.write(r.stderr)
                fail("could not download lwIP from %s" % LWIP_GIT)
            os.rename(tmp, d)
    if not os.path.isfile(os.path.join(d, "src", "include", "lwip", "init.h")):
        fail("[wifi] lwip = %s is not lwIP (no src/include/lwip/init.h)" % d)
    return d


def lwip_sources(proj):
    """lwIP's core, IPv4 and IPv6, Ethernet, and the apps mdfw.ini asks for."""
    src = os.path.join(proj.lwip_dir, "src")
    files = []
    for pat in ("core/*.c", "core/ipv4/*.c", "core/ipv6/*.c", "netif/ethernet.c", "api/err.c"):
        files += sorted(glob.glob(os.path.join(src, pat)))
    for pat in proj.lwip_apps:
        hits = sorted(glob.glob(os.path.join(src, "apps", pat)))
        if not hits:
            fail("[wifi] apps: nothing matches %r in %s" % (pat, os.path.join(src, "apps")))
        files += [h for h in hits if h not in files]
    return files


def slirp_flags():
    """(cflags, libs) for libslirp, which [wifi] needs."""
    out = []
    for what in ("--cflags", "--libs"):
        try:
            r = subprocess.run(["pkg-config", what, "slirp"], capture_output=True, text=True)
        except FileNotFoundError:
            r = None
        if not r or r.returncode:
            if r:
                sys.stderr.write(r.stderr)
            fail("Wi-Fi needs libslirp and pkg-config:\n"
                 "  macOS:  brew install libslirp pkg-config\n"
                 "  Linux:  sudo apt install libslirp-dev libglib2.0-dev pkg-config")
        out.append(shlex.split(r.stdout))
    return out


def out_of_date(obj, src):
    if not os.path.exists(obj):
        return True
    t = os.path.getmtime(obj)
    if os.path.getmtime(src) > t:
        return True
    dep = obj[:-2] + ".d"
    if not os.path.exists(dep):
        return True
    with open(dep) as f:
        text = f.read().replace("\\\n", " ")
    # "obj.o: src.c a.h b.h" then, from -MP, "a.h:" lines; the first line
    # has everything.
    first = text.split("\n", 1)[0]
    for name in first.split(":", 1)[-1].split():
        if not os.path.exists(name) or os.path.getmtime(name) > t:
            return True
    return False


def build(proj, verbose=False, jobs=None, clean=False):
    runtime_srcs = sorted(glob.glob(os.path.join(RUNTIME, "*.c")))
    srcs = proj.sources + runtime_srcs
    if not proj.sources:
        fail("%s lists no sources" % os.path.basename(proj.ini))
    # Wi-Fi: the runtime's chip, lwIP, and libslirp for the network (only
    # net.c needs its headers).
    net_c = os.path.join(RUNTIME, "wifi", "net.c")
    net_cflags, net_libs = [], []
    if proj.template:
        srcs += sorted(glob.glob(os.path.join(RUNTIME, "template", "*.c")))
    if proj.wifi:
        proj.lwip_dir = lwip_source(proj)
        net_cflags, net_libs = slirp_flags()
        srcs += sorted(glob.glob(os.path.join(RUNTIME, "wifi", "*.c"))) + lwip_sources(proj)
    flags = compile_flags(proj)
    os.makedirs(proj.build_dir, exist_ok=True)

    # Rebuild everything when the flags change.
    stamp = os.path.join(proj.build_dir, "flags")
    digest = hashlib.sha1(" ".join(compiler() + compiler(True) + flags + proj.cxxflags
                                   + net_cflags + net_libs).encode()).hexdigest()
    old = open(stamp).read() if os.path.exists(stamp) else ""
    force = clean or old != digest
    if force and os.path.exists(stamp):
        os.remove(stamp)  # until these flags have built everything

    work = []
    for src in srcs:
        obj = object_for(proj, src)
        if force or out_of_date(obj, src):
            work.append((src, obj))

    def cc(item):
        src, obj = item
        os.makedirs(os.path.dirname(obj), exist_ok=True)
        cmd = (compiler(is_cxx(src)) + std_flags(proj, src) + flags
               + (net_cflags if src == net_c else [])
               + ["-MMD", "-MP", "-c", src, "-o", obj])
        r = subprocess.run(cmd, capture_output=True, text=True)
        return src, cmd, r

    failed = wants_wifi = False
    with concurrent.futures.ThreadPoolExecutor(jobs or os.cpu_count() or 4) as pool:
        for src, cmd, r in pool.map(cc, work):
            print("  CC   %s" % os.path.relpath(src, source_base(proj, src)[0]))
            if verbose:
                print("       " + " ".join(shlex.quote(c) for c in cmd))
            if r.stdout or r.stderr:
                sys.stderr.write(r.stdout + r.stderr)
            if r.returncode:
                failed = True
                wants_wifi |= any(h in r.stderr for h in (
                    "cyw43_arch.h", "cyw43.h", "lwip/", "lwipopts.h", "async_context"))
    if failed:
        if wants_wifi and not proj.wifi:
            sys.stderr.write("\nmdfw: that looks like Wi-Fi code: add [wifi] to %s (see EmuMD's\n"
                             "docs/GUIDE.md, Wi-Fi), or leave the network code out.\n"
                             % os.path.basename(proj.ini))
        fail("compile failed")
    with open(stamp, "w") as f:
        f.write(digest)

    objs = [object_for(proj, s) for s in srcs]
    newest = max(os.path.getmtime(o) for o in objs)
    if not work and os.path.exists(proj.output) and os.path.getmtime(proj.output) >= newest:
        print("  %s is up to date" % os.path.relpath(proj.output))
        return proj.output

    os.makedirs(os.path.dirname(proj.output), exist_ok=True)
    # The C++ driver links in its runtime library when there is C++.
    link = (compiler(any(is_cxx(s) for s in srcs))
            + ["-shared", "-o", proj.output] + objs + proj.ldflags + net_libs
            + ["-lm", "-lpthread"])  # as the Pico SDK links its maths library
    if platform.system() == "Linux":
        # Keep the firmware's symbols to itself, and report missing ones now.
        link += ["-Wl,-Bsymbolic", "-Wl,-z,defs"]
    print("  LINK %s" % os.path.relpath(proj.output))
    if verbose:
        print("       " + " ".join(shlex.quote(c) for c in link))
    r = subprocess.run(link, capture_output=True, text=True)
    if r.returncode:
        sys.stderr.write(r.stdout + r.stderr)
        if "ndefined" in r.stderr:
            sys.stderr.write(
                "\nmdfw: the firmware calls functions the runtime does not provide.\n"
                "Leave the sources that set up hardware out of mdfw.ini, and define\n"
                "any other missing function in your glue file (or a shim .c).\n")
        fail("link failed")
    return proj.output


# ---------------------------------------------------------------------------
# Looking at a .mdfw
# ---------------------------------------------------------------------------

class _Plugin(ctypes.Structure):
    _fields_ = [("abi", ctypes.c_uint32), ("name", ctypes.c_char_p),
                ("version", ctypes.c_char_p)]


def describe(path):
    """(abi, name, version) of a .mdfw, or raise."""
    lib = ctypes.CDLL(os.path.abspath(path), mode=getattr(ctypes, "RTLD_LOCAL", 0))
    entry = lib.emumd_plugin_v1
    entry.restype = ctypes.POINTER(_Plugin)
    p = entry().contents
    return p.abi, p.name.decode(errors="replace"), (p.version or b"").decode(errors="replace")


